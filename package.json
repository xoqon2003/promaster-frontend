{
  "name": "ustatop-frontend",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "cross-env NODE_ENV=production turbo run build",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "analyze": "cross-env ANALYZE=true NODE_ENV=production turbo run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.f7d2598",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
