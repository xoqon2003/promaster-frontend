{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "env": ["CI"]
    }
  },
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "ANALYZE",
    "MOCK_OTP",
    "AUTH_SECRET",
    "NEXTAUTH_URL",
    "DATABASE_URL",
    "OTP_PROVIDER",
    "ESKIZ_EMAIL",
    "ESKIZ_PASSWORD",
    "ESKIZ_API_BASE",
    "ESKIZ_SENDER",
    "SENTRY_SMOKE_ENABLED",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "VERCEL_ENV",
    "VERCEL_URL",
    "NEXT_RUNTIME"
  ]
}
