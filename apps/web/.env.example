# =====================================================================
# UstaTop / Promaster — Environment Variables Template
# Ushbu faylni nusxalang: cp .env.example .env.local
# .env.local faylini HECH QACHON commit qilmang (.gitignore'da)
# =====================================================================

# ─── Next.js / NextAuth ──────────────────────────────────────────────────────
# NextAuth secret — `openssl rand -base64 32` orqali generate
NEXTAUTH_SECRET=
# Local dev: http://localhost:3000 — staging/prod: https://promaster.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Neon connection string. Sozlash: lib/db/README.md
# Format: postgres://USER:PASSWORD@ep-XXX.eu-central-1.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# ─── OTP / SMS provider ──────────────────────────────────────────────────────
# Default: mock — dev va staging'da ishlatiladi (MOCK_OTP=123456)
# Production aktivatsiya'da: eskiz (Eskiz.uz adapter — defer)
OTP_PROVIDER=mock

# Mock provider (faqat OTP_PROVIDER=mock paytida)
MOCK_OTP=123456

# Eskiz.uz (faqat OTP_PROVIDER=eskiz paytida — aktivatsiya'da to'ldiriladi)
ESKIZ_API_BASE=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender ID — approval'gacha "4546" (Eskiz default test sender)
ESKIZ_SENDER=Promaster

# ─── Sentry (T5.09) ──────────────────────────────────────────────────────────
# Organization: smart-technologies-group
# DSN: Sentry → Settings → Projects → promaster-frontend → Client Keys
# Auth token (build paytda source map upload): Settings → Account → Auth Tokens
#   Scopes: project:write, project:releases, org:read
# NEXT_PUBLIC_SENTRY_DSN — client bundle'ga ekspoz qilinadi (DSN public-safe)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=smart-technologies-group
SENTRY_PROJECT=promaster-frontend
SENTRY_AUTH_TOKEN=
# Smoke test endpoint /api/sentry-smoke ni yoqish (faqat staging'da true)
SENTRY_SMOKE_ENABLED=false

# ─── Yandex Maps (S03 dan) ───────────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# ─── Mixpanel (S04 dan) ──────────────────────────────────────────────────────
NEXT_PUBLIC_MIXPANEL_TOKEN=
